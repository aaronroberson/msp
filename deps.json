{
  "dependencies": {
    "fswatch": {
      "name": "fswatch",
      "description": "File system watcher for real-time monitoring",
      "type": "formula",
      "required": true,
      "auto_install": true,
      "install_cmd": "brew install fswatch",
      "verify_cmd": "which fswatch"
    },
    "ollama": {
      "name": "ollama",
      "description": "Local LLM inference server (privacy-first AI)",
      "type": "formula",
      "required": true,
      "auto_install": true,
      "install_cmd": "brew install ollama",
      "verify_cmd": "ollama --version",
      "note": "Run 'ollama serve' to start, then 'ollama pull qwen2.5-coder:1.5b' (~1GB RAM, runs on any Mac)"
    },
    "apfel": {
      "name": "apfel",
      "description": "Apple Intelligence from the command line (fallback)",
      "type": "formula",
      "required": false,
      "auto_install": false,
      "install_cmd": "brew install apfel",
      "verify_cmd": "which apfel",
      "note": "Optional fallback when Ollama is unavailable"
    },
    "processmonitor": {
      "name": "ProcessMonitor",
      "description": "Monitor process creations via Endpoint Security",
      "type": "cask",
      "required": false,
      "auto_install": false,
      "install_cmd": "brew install --cask processmonitor",
      "verify_cmd": "ls /Applications/ProcessMonitor.app",
      "path": "/Applications/ProcessMonitor.app/Contents/MacOS/ProcessMonitor"
    },
    "knockknock": {
      "name": "KnockKnock",
      "description": "Enumerate persistently installed software",
      "type": "cask",
      "required": false,
      "auto_install": false,
      "install_cmd": "brew install --cask knockknock",
      "verify_cmd": "ls /Applications/KnockKnock.app",
      "path": "/Applications/KnockKnock.app/Contents/MacOS/KnockKnock"
    },
    "wireshark": {
      "name": "Wireshark",
      "description": "Network protocol analyzer (tshark CLI)",
      "type": "formula",
      "required": false,
      "auto_install": false,
      "install_cmd": "brew install wireshark",
      "verify_cmd": "which tshark",
      "note": "Heavy package (~100MB), install only if needed"
    },
    "somo": {
      "name": "somo",
      "description": "Human-friendly network monitor",
      "type": "formula",
      "required": false,
      "auto_install": false,
      "install_cmd": "brew install somo",
      "verify_cmd": "which somo"
    },
    "nmap": {
      "name": "nmap",
      "description": "Network scanner for discovering devices and open ports",
      "type": "formula",
      "required": false,
      "auto_install": false,
      "install_cmd": "brew install nmap",
      "verify_cmd": "which nmap",
      "note": "Used for network device discovery (msp net nmap)"
    },
    "exiftool": {
      "name": "exiftool",
      "description": "Read and write meta information in files (image/video forensics)",
      "type": "formula",
      "required": false,
      "auto_install": false,
      "install_cmd": "brew install exiftool",
      "verify_cmd": "which exiftool",
      "note": "Used for deep media metadata and camera forensics (msp forensics inspect/scan)"
    },
    "openvino": {
      "name": "openvino",
      "description": "Intel OpenVINO toolkit for AI acceleration (supports USB NPU devices)",
      "type": "pip",
      "required": false,
      "auto_install": false,
      "install_cmd": "pip install openvino",
      "verify_cmd": "python3 -c 'import openvino; print(openvino.__version__)' 2>/dev/null",
      "note": "For Intel NCS2, NCS2+, and other USB AI accelerators. Requires model IR conversion."
    }
  },
  "system_checks": {
    "gatekeeper": {
      "cmd": "spctl --status",
      "enabled_pattern": "assessments enabled"
    },
    "firewall": {
      "cmd": "/usr/libexec/ApplicationFirewall/socketfilterfw --getglobalstate",
      "enabled_pattern": "enabled"
    },
    "filevault": {
      "cmd": "fdesetup status",
      "enabled_pattern": "FileVault is On"
    }
  }
}